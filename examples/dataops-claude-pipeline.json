[
    {
        "id": "cp-comment",
        "type": "comment",
        "name": "AI-assisted normalization",
        "info": "1. The four sensor injects fill the wrapped cache `AI_Pipeline_Cache` (OPC UA, Kepware and Sparkplug payload styles).\n2. Click **Generate Specs**. `dataops-claude` sends the cache samples to Claude and writes one spec per topic to `global.dataopsSpecs`. Set the Claude API config first.\n3. **Live Data** runs through `dataops-transform`, which applies the generated spec. Before specs exist, the message goes to output 2 (fallback mode = passthrough).\n\nInspect `global.dataopsSpecs` in the Context sidebar, or edit specs by hand and re-run Live Data.",
        "x": 180,
        "y": 40,
        "wires": []
    },
    {
        "id": "claude-api-config",
        "type": "dataops-claude-api",
        "name": "My Claude API",
        "model": "claude-opus-5-5",
        "baseUrl": "",
        "maxTokens": 16384,
        "effort": "",
        "temperature": "",
        "fallbacks": true
    },
