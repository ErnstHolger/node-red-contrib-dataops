{
  "name": "node-red-contrib-dataops",
  "version": "2.0.0",
  "description": "Node-RED nodes for industrial data pipelines: tag cache, AI-assisted and heuristic normalization, second-resolution cron, and run-time tracking",
  "author": {
    "name": "Holger Amort"
  },
  "keywords": [
    "node-red",
    "dataops",
    "iiot",
    "opc-ua",
    "sparkplug",
    "mqtt",
    "normalization",
    "jsonata",
    "time-series",
    "cron",
    "claude"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ErnstHolger/node-red-contrib-dataops#readme",
  "bugs": {
    "url": "https://github.com/ErnstHolger/node-red-contrib-dataops/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErnstHolger/node-red-contrib-dataops.git"
  },
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "dataops-in": "nodes/dataops-in.js",
      "dataops-cron": "nodes/dataops-cron.js",
      "dataops-runtime": "nodes/dataops-runtime.js",
      "dataops-claude-api": "nodes/dataops-claude-api.js",
      "dataops-claude": "nodes/dataops-claude.js",
      "dataops-transform": "nodes/dataops-transform.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "deploy": "npm link",
    "deploy:patch": "npm version patch --no-git-tag-version && npm link",
    "deploy:minor": "npm version minor --no-git-tag-version && npm link",
    "deploy:major": "npm version major --no-git-tag-version && npm link",
    "publish:dry": "npm publish --dry-run",
    "publish:patch": "npm version patch && npm publish",
    "publish:minor": "npm version minor && npm publish",
    "publish:major": "npm version major && npm publish",
    "examples:install": "node scripts/install-examples.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0"
  },
  "devDependencies": {
    "node-red": "^4.1.16",
    "node-red-node-test-helper": "^0.3.6"
  },
  "files": [
    "nodes/",
    "lib/",
    "resources/",
    "examples/",
    "LICENSE",
    "README.md"
  ]
}
