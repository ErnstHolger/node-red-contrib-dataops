: -A,\n    triangle: A * (1 - 4 * Math.abs(x - 0.5))  // -100 .. +100 .. -100\n};\n\nconst ts = new Date(now).toISOString();\nconst msgs = Object.keys(waves).map(name => ({\n    topic: 'testtopic/sim/' + name,\n    payload: {\n        value: Math.round(waves[name] * 100) / 100,\n        timestamp: ts,\n        quality: true\n    }\n}));\n// Nested array: one inner array = a sequence of messages out of port 1.\n// (A flat array would be treated as one-per-output-port and drop all but the first.)\nreturn [msgs];","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":320,"y":200,"wires":[["sim-mqtt","sim-debug"]]},{"id":"sim-mqtt","type":"mqtt out","z":"sim-tab","name":"UNS publish","topic":"","qos":"0","retain":"true","respTopic":"","contentType":"","userProps":"","correl":"","expiry":"","broker":"f8654e321ca3b9b8","x":530,"y":200,"wires":[]},{"id":"sim-debug","type":"debug","z":"sim-tab","name":"sim out","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":530,"y":280,"wires":[]}]